{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/antigravity-behavior-engineering/task-checkpoint.schema.json",
  "title": "TaskCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "taskTitle",
    "taskEntryDigest",
    "baseCommit",
    "implementationCommit",
    "treeDigest",
    "outcome",
    "files",
    "verification",
    "reviews",
    "publicBoundary",
    "rollback",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^T0(0[1-9]|[1-3][0-9]|4[0-6])$" },
    "taskTitle": { "type": "string", "minLength": 1 },
    "taskEntryDigest": { "$ref": "#/$defs/sha256" },
    "baseCommit": { "$ref": "#/$defs/commit" },
    "implementationCommit": { "$ref": "#/$defs/commit" },
    "treeDigest": { "$ref": "#/$defs/sha256" },
    "outcome": { "enum": ["implemented", "not_selected", "gate_approved", "gate_rejected"] },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "verification": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "argv", "expectedExit", "actualExit", "outputDigest"],
        "properties": {
          "phase": { "enum": ["red", "green", "sentinel", "artifact", "gate"] },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "expectedExit": { "type": "integer" },
          "actualExit": { "type": "integer" },
          "outputDigest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "reviewInputDigest", "verdictDigest", "verdict", "openMaterialFindings"],
        "properties": {
          "role": { "enum": ["requirements", "quality"] },
          "reviewInputDigest": { "$ref": "#/$defs/sha256" },
          "verdictDigest": { "$ref": "#/$defs/sha256" },
          "verdict": { "enum": ["pass", "fail", "indeterminate"] },
          "openMaterialFindings": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "publicBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanDigest", "criticalFindings"],
      "properties": {
        "scanDigest": { "$ref": "#/$defs/sha256" },
        "criticalFindings": { "const": 0 }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "tested"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "tested": { "type": "boolean" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
