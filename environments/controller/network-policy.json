{
  "schemaVersion": 1,
  "behaviorRuns": {
    "hostNetwork": "deny",
    "packageManagerNetwork": "deny",
    "dependencyInstallation": "deny",
    "inferenceEgress": "controller-allowlist-only",
    "allowedEgress": [
      "authenticated-antigravity-inference"
    ],
    "deniedPackageManagerHosts": [
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "files.pythonhosted.org"
    ],
    "localDenialTestProfile": "docker-network-none",
    "ambientBrowserOrDesktopState": "deny"
  },
  "qualificationRuns": {
    "packageManagerNetwork": "pinned-dependencies-only",
    "modelPreflight": "allow-authenticated-antigravity-inference",
    "fallbackProbe": "allow-authenticated-antigravity-inference"
  },
  "publicWorkerImage": {
    "containsCredentials": false,
    "containsAuthorizedCli": false,
    "requiresRuntimeCliBind": true
  }
}
