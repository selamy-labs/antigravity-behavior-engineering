{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity-behavior-engineering.dev/schemas/review-pair-envelope.schema.json",
  "title": "ReviewPairEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pairId",
    "artifactDigest",
    "obligationDigest",
    "verificationInterfaceDigest",
    "authorityDigest",
    "sharedPackageManifestDigest",
    "reviewPairEnvelopeDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pairId": { "type": "string", "minLength": 1 },
    "artifactDigest": { "$ref": "#/$defs/digest" },
    "obligationDigest": { "$ref": "#/$defs/digest" },
    "verificationInterfaceDigest": { "$ref": "#/$defs/digest" },
    "authorityDigest": { "$ref": "#/$defs/digest" },
    "sharedPackageManifestDigest": { "$ref": "#/$defs/digest" },
    "reviewPairEnvelopeDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
