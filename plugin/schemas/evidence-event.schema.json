{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity-behavior-engineering.dev/schemas/evidence-event.schema.json",
  "title": "EvidenceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "taskId",
    "sequence",
    "eventKind",
    "toolName",
    "resultClass",
    "redactedPayloadDigest",
    "previousEventDigest",
    "occurredAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$" },
    "taskId": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "eventKind": { "enum": ["post_tool_use", "post_invocation"] },
    "toolName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "resultClass": { "enum": ["success", "error", "indeterminate"] },
    "redactedPayloadDigest": { "$ref": "#/$defs/digest" },
    "previousEventDigest": {
      "oneOf": [
        { "const": "genesis" },
        { "$ref": "#/$defs/digest" }
      ]
    },
    "occurredAt": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "eventKind": { "const": "post_tool_use" } },
        "required": ["eventKind"]
      },
      "then": {
        "properties": { "toolName": { "not": { "const": "not_applicable" } } }
      },
      "else": {
        "properties": { "toolName": { "const": "not_applicable" } }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-9])))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "allOf": [{
        "if": { "pattern": "^\\d{4}-02-29T" },
        "then": {
          "pattern": "^(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:00|0[48]|[2468][048]|[13579][26])00)-02-29T"
        }
      }]
    }
  }
}
