{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity-behavior-engineering.dev/schemas/evidence-event.schema.json",
  "title": "EvidenceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "taskId",
    "sequence",
    "eventKind",
    "toolName",
    "resultClass",
    "redactedPayloadDigest",
    "previousEventDigest",
    "occurredAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "eventKind": { "enum": ["post_tool_use", "post_invocation"] },
    "toolName": {
      "oneOf": [
        { "const": "not_applicable" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "resultClass": { "enum": ["success", "error", "indeterminate"] },
    "redactedPayloadDigest": { "$ref": "#/$defs/digest" },
    "previousEventDigest": {
      "oneOf": [
        { "const": "genesis" },
        { "$ref": "#/$defs/digest" }
      ]
    },
    "occurredAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
