{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity-behavior-engineering.dev/schemas/review-request.schema.json",
  "title": "ReviewRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "reviewerRole",
    "reviewPairEnvelopeDigest",
    "artifactDigest",
    "obligationDigest",
    "verificationInterfaceDigest",
    "authorityDigest",
    "packageManifestDigest",
    "reviewRequestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$" },
    "reviewerRole": { "enum": ["requirements", "quality"] },
    "reviewPairEnvelopeDigest": { "$ref": "#/$defs/digest" },
    "artifactDigest": { "$ref": "#/$defs/digest" },
    "obligationDigest": { "$ref": "#/$defs/digest" },
    "verificationInterfaceDigest": { "$ref": "#/$defs/digest" },
    "authorityDigest": { "$ref": "#/$defs/digest" },
    "packageManifestDigest": { "$ref": "#/$defs/digest" },
    "reviewRequestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
