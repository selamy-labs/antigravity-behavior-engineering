{
  "evidence-observer": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/evidence-observer.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node scripts/evidence-observer.mjs",
        "timeout": 10
      }
    ]
  },
  "bounded-completion-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/bounded-completion-gate.mjs",
        "timeout": 10
      }
    ]
  }
}
